    },
    {
      "commentator_name": "מנחת שי",
      "commentary_text": "מתחת. הראשון התי\"ו בקמץ ופתח כמו שכתבתי בפ' יתרו:",
      "source_url": "https://www.sefaria.org/Minchat_Shai_on_Torah,_Deuteronomy_5:8:6"
